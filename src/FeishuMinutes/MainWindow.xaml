<Window x:Class="FeishuMinutes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="妙记字幕下载器"
        Icon="Assets/app.ico"
        Width="980"
        Height="700"
        MinWidth="880"
        MinHeight="630"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,0,31">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="5">
                        <StackPanel VerticalAlignment="Center">
                            <Rectangle Width="20" Height="3" Fill="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,4" />
                            <Rectangle Width="15" Height="3" Fill="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,4" />
                            <Rectangle Width="20" Height="3" Fill="{DynamicResource AccentForegroundBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="妙记字幕" />
                        <TextBlock Margin="0,2,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Native for Windows 11" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="4,0,0,9"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="下载流程" />

                <StackPanel Grid.Row="2">
                    <Grid Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step1Badge"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ActiveBadgeBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="1" />
                        </Border>
                        <TextBlock x:Name="Step1Text"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="粘贴妙记链接" />
                    </Grid>
                    <Grid Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step2Badge"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PendingBadgeBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="2" />
                        </Border>
                        <TextBlock x:Name="Step2Text"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="提取逐句字幕" />
                    </Grid>
                    <Grid Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step3Badge"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PendingBadgeBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="3" />
                        </Border>
                        <TextBlock x:Name="Step3Text"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="打开输出文件" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,24,0,0"
                        Padding="13,12"
                        Background="{DynamicResource StatusCardBrush}"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot"
                                 Width="7"
                                 Height="7"
                                 Margin="0,5,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Fill="{DynamicResource AccentBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatusTitle"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="准备就绪" />
                            <TextBlock x:Name="StatusDetail"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="粘贴飞书妙记分享链接即可开始"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="5" Margin="4,0,0,0">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="v1.1.0 · Windows 11 x64" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="纯 HTTP · 无浏览器依赖" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,29,38,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="2,0,0,21">
                <TextBlock FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Text="下载飞书妙记字幕" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="从分享链接生成时间轴准确的 SRT 字幕文件" />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="24,19"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,7"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="妙记分享链接" />
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 KeyDown="UrlTextBox_KeyDown" />
                        <Button Grid.Column="1"
                                Margin="9,0,0,0"
                                Click="PasteButton_Click"
                                Content="粘贴"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Margin="0,0,0,7"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="保存位置" />
                    <Grid Grid.Row="3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputTextBox" Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1"
                                Margin="9,0,0,0"
                                Click="BrowseButton_Click"
                                Content="浏览…"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="NameByTitleCheckBox"
                                  VerticalAlignment="Center"
                                  Content="使用妙记标题命名字幕"
                                  IsChecked="True" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="每行" />
                            <TextBox x:Name="MaxCharactersTextBox"
                                     Width="54"
                                     Height="32"
                                     Margin="6,0"
                                     Padding="8,4"
                                     HorizontalContentAlignment="Center"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="22" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="字 · 最长" />
                            <TextBox x:Name="MaxDurationTextBox"
                                     Width="68"
                                     Height="32"
                                     Margin="6,0"
                                     Padding="8,4"
                                     HorizontalContentAlignment="Center"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="2500" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="毫秒" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,17,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DownloadButton"
                        Grid.Column="0"
                        Click="DownloadButton_Click"
                        Content="下载字幕"
                        IsDefault="True"
                        Style="{StaticResource AccentButton}" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="OpenFolderButton"
                        Grid.Column="3"
                        Click="OpenFolderButton_Click"
                        Content="打开文件夹"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid Margin="18,14,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,9">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="运行记录" />
                        <TextBlock x:Name="LogStateText"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="等待开始" />
                    </Grid>
                    <ProgressBar x:Name="ProgressBar"
                                 Grid.Row="1"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="2"
                             Margin="0,10,0,0"
                             Padding="11,9"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="{DynamicResource LogBackgroundBrush}"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                             FontSize="12"
                             Foreground="{DynamicResource LogTextBrush}"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
